# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Phone alerts (optional; the bell in the app works without them). Make these on /admin, then
# link the database to the app with the SQL shown there.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_SECRET=

# Legal contact details shown on /terms, /privacy and /copyright (set these in Vercel).
NEXT_PUBLIC_LEGAL_EMAIL=
# One line, e.g. "PO Box 123, Miami, FL 33101"
NEXT_PUBLIC_LEGAL_ADDRESS=
# The name you register as DMCA agent at https://dmca.copyright.gov
NEXT_PUBLIC_DMCA_AGENT=
