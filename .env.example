# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Instagram connect (optional). From the Meta app: Instagram > API setup with Instagram login > Business login settings.
# Leave empty and the Connect Instagram buttons stay hidden; creators can still paste reel links.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
